# ===== Konekt postavke =====
# Kopiraj u .env (ili pokreni: npm.cmd run postavi, koji sam napravi ključeve).

# development ili production
NODE_ENV=development
PORT=3000
# Javna adresa aplikacije, bez kose crte na kraju (koristi se u emailovima i linkovima)
JAVNI_URL=http://localhost:3000
# Putanja do baze (SQLite fajl). Na hostingu mora biti na trajnom disku.
BAZA_PUT=podaci/konekt.db
# 1 ako aplikacija radi iza proxyja (Render, Railway, Nginx...), inače 0
IZA_PROXYJA=0

# Tajna za heširanje tokena (pravi se sama). Imena i telefoni klijenata se zaključavaju
# u pregledniku ključem samog biznisa, pa server za njih nema i ne treba ključ.
PEPPER=

# Emailovi koji imaju pristup admin pregledu (odvojeni zarezom)
ADMIN_EMAILS=

# Pretplata: kupac plati (gotovina ili račun), pa mu admin napravi pozivnicu za otvaranje profila
PRETPLATA_CIJENA_KM=50
# Profil koji se prikazuje kao primjer na početnoj (posjetioci ne mogu stvarno zakazati)
DEMO_PROFIL=ordinacija-osmijeh
PLACANJE_UPUTE=Pretplata se plaća gotovinom ili uplatom na račun. Javi nam se za podatke za uplatu.
# Telefon za kontakt (prikazuje se biznisima u panelu kod pretplate)
KONTAKT_TELEFON=067-140-6698

# Koliko mjeseci se čuvaju stari termini prije automatskog brisanja
TERMINI_CUVANJE_MJESECI=12

# Email (SMTP). Ako je SMTP_HOST prazan, emailovi se samo ispisuju u terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_KORISNIK=
SMTP_LOZINKA=
EMAIL_POSILJALAC=Konekt <no-reply@konekt.ba>
